{
  "name": "@wingetcord/wingetcord",
  "version": "1.0.0",
  "type": "module",
  "description": "A high-performance modular Discord framework written in TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "framework",
    "wingetcord"
  ],
