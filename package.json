{
  "name": "@wingetcord/wingetcord",
  "version": "1.0.0",
  "description": "A high-performance TypeScript Discord framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "wingetcord": "./dist/cli/index.js"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "framework",
    "wingetcord"
  ],
  "author": "Mr.Winget",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --clean",
    "dev": "tsx watch examples/basic-bot/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cron-parser": "^4.9.0",
    "discord-api-types": "^0.37.0",
    "pako": "^2.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "undici": "^6.0.0"
  },
  "peerDependencies": {
    "@discordjs/voice": "^0.17.0",
    "ffmpeg-static": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "@discordjs/voice": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@jest/globals": "^29.0.0",
    "@types/pako": "^2.0.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
